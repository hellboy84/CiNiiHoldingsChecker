{
  "manifest_version": 3,
  "name": "CiNii 共通所蔵館チェッカー",
  "version": "1.2",
  "description": "CiNii Booksで複数の雑誌の共通所蔵館を抽出します / Finds libraries that commonly hold specified volumes across multiple journals on CiNii Books",
  "permissions": ["storage", "activeTab", "scripting"],
  "browser_specific_settings": {
   "gecko": {
     "id": "cinii-holdings-checker@hellboy84",
     "data_collection_permissions": {
       "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CiNii 共通所蔵館チェッカー",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png"
    }
  }
}


